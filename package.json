{
    "name": "forgeiq-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "build": "tsc",
        "start": "bun dist/src/server.js",
        "stripe:webhook": "stripe listen --forward-to localhost:5000/api/v1/payments/webhook",
        "format:check": "biome format ./src",
        "format:fix": "biome format --write ./src",
        "lint:check": "biome lint ./src",
        "lint:fix": "biome lint --write ./src"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.8",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.2.0",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.21.0",
        "prisma": "^7.9.1",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    }
}
