<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>ForgeIQ — Email Verification</title>

        <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #eef2f6;
                font-family: Arial, Helvetica, sans-serif;
                color: #172033;
            }

            .wrapper {
                width: 100%;
                padding: 40px 16px;
                box-sizing: border-box;
            }

            .container {
                max-width: 560px;
                margin: 0 auto;
                background: #ffffff;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 10px 35px rgba(15, 23, 42, 0.1);
            }

            /* Header */
            .header {
                background: #0b1220;
                padding: 28px 35px;
                text-align: center;
                border-bottom: 4px solid #f59e0b;
            }

            .logo {
                margin: 0;
                color: #ffffff;
                font-size: 28px;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .logo span {
                color: #f59e0b;
            }

            .tagline {
                margin: 7px 0 0;
                color: #94a3b8;
                font-size: 12px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            /* Content */
            .content {
                padding: 40px 38px;
            }

            .icon {
                width: 52px;
                height: 52px;
                line-height: 52px;
                margin-bottom: 20px;
                text-align: center;
                border-radius: 12px;
                background: #fff7e6;
                color: #f59e0b;
                font-size: 24px;
                font-weight: bold;
            }

            .title {
                margin: 0 0 12px;
                color: #111827;
                font-size: 25px;
                line-height: 1.3;
            }

            .text {
                margin: 0 0 16px;
                color: #64748b;
                font-size: 15px;
                line-height: 1.7;
            }

            .name {
                color: #111827;
                font-weight: 700;
            }

            .email {
                color: #334155;
                font-weight: 600;
            }

            /* OTP */
            .otp-container {
                margin: 28px 0;
                padding: 25px;
                text-align: center;
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
            }

            .otp-label {
                margin: 0 0 12px;
                color: #64748b;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            .otp {
                display: inline-block;
                padding: 13px 22px;
                background: #0b1220;
                color: #f59e0b;
                border-radius: 8px;
                font-family: 'Courier New', Courier, monospace;
                font-size: 30px;
                line-height: 1;
                font-weight: 800;
                letter-spacing: 8px;
            }

            .expiration {
                margin: 14px 0 0;
                color: #64748b;
                font-size: 12px;
            }

            .expiration strong {
                color: #334155;
            }

            /* Verification Notice */
            .verification {
                margin-top: 25px;
                padding: 16px 18px;
                background: #fffaf0;
                border-left: 4px solid #f59e0b;
                border-radius: 6px;
            }

            .verification-title {
                margin: 0 0 6px;
                color: #92400e;
                font-size: 13px;
                font-weight: 700;
            }

            .verification-text {
                margin: 0;
                color: #78716c;
                font-size: 12px;
                line-height: 1.6;
            }

            /* Footer */
            .footer {
                padding: 24px 35px;
                background: #f8fafc;
                border-top: 1px solid #e2e8f0;
                text-align: center;
            }

            .footer-brand {
                margin: 0 0 8px;
                color: #334155;
                font-size: 14px;
                font-weight: 700;
            }

            .footer-accent {
                color: #f59e0b;
            }

            .footer-text {
                margin: 0;
                color: #94a3b8;
                font-size: 11px;
                line-height: 1.6;
            }

            @media only screen and (max-width: 600px) {
                .wrapper {
                    padding: 20px 10px;
                }

                .header {
                    padding: 24px 20px;
                }

                .content {
                    padding: 30px 22px;
                }

                .footer {
                    padding: 22px 20px;
                }

                .title {
                    font-size: 22px;
                }

                .otp {
                    font-size: 25px;
                    letter-spacing: 6px;
                }
            }
        </style>
    </head>

    <body>
        <div class="wrapper">
            <div class="container">
                <!-- ForgeIQ Header -->
                <div class="header">
                    <h1 class="logo">Forge<span>IQ</span></h1>

                    <p class="tagline">Intelligent Industrial Operations</p>
                </div>

                <!-- Main Content -->
                <div class="content">
                    <div class="icon">✓</div>

                    <h2 class="title">Verify Your Email Address</h2>

                    <p class="text">
                        Hello
                        <span class="name"><%= name %></span>,
                    </p>

                    <p class="text">
                        Welcome to ForgeIQ. To complete your account setup,
                        please verify the email address associated with your
                        account:
                    </p>

                    <p class="text">
                        <span class="email"><%= email %></span>
                    </p>

                    <p class="text">
                        Enter the verification code below to confirm that this
                        email address belongs to you.
                    </p>

                    <!-- OTP -->
                    <div class="otp-container">
                        <p class="otp-label">Email Verification Code</p>

                        <div class="otp"><%= otp %></div>

                        <p class="expiration">
                            This code expires in
                            <strong> <%= expirationMinutes %> minutes </strong>.
                        </p>
                    </div>

                    <!-- Verification Notice -->
                    <div class="verification">
                        <p class="verification-title">
                            Didn't request this verification?
                        </p>

                        <p class="verification-text">
                            If you did not create a ForgeIQ account or request
                            this verification email, you can safely ignore this
                            message. Never share your verification code with
                            anyone.
                        </p>
                    </div>
                </div>

                <!-- Footer -->
                <div class="footer">
                    <p class="footer-brand">
                        Forge<span class="footer-accent">IQ</span>
                    </p>

                    <p class="footer-text">
                        Intelligent Industrial Operations Platform
                    </p>

                    <p class="footer-text">
                        &copy; <%= new Date().getFullYear() %> ForgeIQ. All
                        rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </body>
</html>
