<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>ForgeIQ — Password Reset Successful</title>

        <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #eef2f6;
                font-family: Arial, Helvetica, sans-serif;
                color: #172033;
            }

            .wrapper {
                width: 100%;
                padding: 40px 16px;
                box-sizing: border-box;
            }

            .container {
                max-width: 560px;
                margin: 0 auto;
                background: #ffffff;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 10px 35px rgba(15, 23, 42, 0.1);
            }

            /* Header */
            .header {
                background: #0b1220;
                padding: 28px 35px;
                text-align: center;
                border-bottom: 4px solid #f59e0b;
            }

            .logo {
                margin: 0;
                color: #ffffff;
                font-size: 28px;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .logo span {
                color: #f59e0b;
            }

            .tagline {
                margin: 7px 0 0;
                color: #94a3b8;
                font-size: 12px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
            }

            /* Content */
            .content {
                padding: 42px 38px;
            }

            .success-icon {
                width: 58px;
                height: 58px;
                line-height: 58px;
                margin-bottom: 22px;
                text-align: center;
                border-radius: 14px;
                background: #ecfdf5;
                color: #16a34a;
                font-size: 30px;
                font-weight: 800;
            }

            .title {
                margin: 0 0 14px;
                color: #111827;
                font-size: 27px;
                line-height: 1.3;
            }

            .text {
                margin: 0 0 17px;
                color: #64748b;
                font-size: 15px;
                line-height: 1.75;
            }

            .name {
                color: #111827;
                font-weight: 700;
            }

            /* Success Status */
            .success-box {
                margin: 28px 0;
                padding: 20px;
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
                border-radius: 10px;
            }

            .success-title {
                margin: 0 0 6px;
                color: #166534;
                font-size: 14px;
                font-weight: 700;
            }

            .success-text {
                margin: 0;
                color: #4b7c5b;
                font-size: 12px;
                line-height: 1.6;
            }

            /* Security Notice */
            .security {
                margin-top: 25px;
                padding: 16px 18px;
                background: #fffaf0;
                border-left: 4px solid #f59e0b;
                border-radius: 6px;
            }

            .security-title {
                margin: 0 0 6px;
                color: #92400e;
                font-size: 13px;
                font-weight: 700;
            }

            .security-text {
                margin: 0;
                color: #78716c;
                font-size: 12px;
                line-height: 1.6;
            }

            /* CTA */
            .cta-container {
                margin: 30px 0 5px;
                text-align: center;
            }

            .cta {
                display: inline-block;
                padding: 13px 28px;
                background: #f59e0b;
                color: #111827 !important;
                border-radius: 7px;
                font-size: 14px;
                font-weight: 700;
                text-decoration: none;
            }

            /* Footer */
            .footer {
                padding: 24px 35px;
                background: #f8fafc;
                border-top: 1px solid #e2e8f0;
                text-align: center;
            }

            .footer-brand {
                margin: 0 0 8px;
                color: #334155;
                font-size: 14px;
                font-weight: 700;
            }

            .footer-accent {
                color: #f59e0b;
            }

            .footer-text {
                margin: 0;
                color: #94a3b8;
                font-size: 11px;
                line-height: 1.6;
            }

            @media only screen and (max-width: 600px) {
                .wrapper {
                    padding: 20px 10px;
                }

                .header {
                    padding: 24px 20px;
                }

                .content {
                    padding: 32px 22px;
                }

                .footer {
                    padding: 22px 20px;
                }

                .title {
                    font-size: 23px;
                }
            }
        </style>
    </head>

    <body>
        <div class="wrapper">
            <div class="container">
                <!-- ForgeIQ Header -->
                <div class="header">
                    <h1 class="logo">Forge<span>IQ</span></h1>

                    <p class="tagline">Intelligent Industrial Operations</p>
                </div>

                <!-- Main Content -->
                <div class="content">
                    <div class="success-icon">✓</div>

                    <h2 class="title">Password Reset Successful</h2>

                    <p class="text">
                        Hello
                        <span class="name"><%= name %></span>,
                    </p>

                    <p class="text">
                        Your ForgeIQ account password has been changed
                        successfully.
                    </p>

                    <!-- Success Status -->
                    <div class="success-box">
                        <p class="success-title">✓ Your account is secure</p>

                        <p class="success-text">
                            Your new password is now active. You can use it the
                            next time you sign in to your ForgeIQ account.
                        </p>
                    </div>

                    <p class="text">
                        If you made this change, no further action is required.
                        You can now continue using ForgeIQ normally.
                    </p>

                    <!-- Security Notice -->
                    <div class="security">
                        <p class="security-title">Didn't make this change?</p>

                        <p class="security-text">
                            If you did not reset your password, your account may
                            have been compromised. Please contact the ForgeIQ
                            support team immediately and secure your account.
                        </p>
                    </div>

                    <!-- CTA -->
                    <div class="cta-container">
                        <a href="#" class="cta"> Sign In to ForgeIQ </a>
                    </div>
                </div>

                <!-- Footer -->
                <div class="footer">
                    <p class="footer-brand">
                        Forge<span class="footer-accent">IQ</span>
                    </p>

                    <p class="footer-text">
                        Intelligent Industrial Operations Platform
                    </p>

                    <p class="footer-text">
                        &copy; <%= new Date().getFullYear() %> ForgeIQ. All
                        rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </body>
</html>
